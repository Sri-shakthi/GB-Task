# Database (Neon pooled connection)
DATABASE_URL=
# Owner session secrets (minimum 32 random characters)
AUTH_SECRET=
# Generated locally; signs the cached Neon Auth session cookie.
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
RESTAURANT_ID=
OWNER_EMAIL=owner@example.com
# Generate with: npm run auth:hash -- "a long unique password"
OWNER_PASSWORD_HASH=
# 32 random bytes encoded as base64, used to encrypt optional TOTP secrets
MFA_ENCRYPTION_KEY=
# Automated password recovery email
RESEND_API_KEY=
AUTH_EMAIL_FROM=Ganesh Bhavan <tasks@example.com>
# Public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Development adapter prevents real sends when true
WHATSAPP_DEV_MODE=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VIDEO_TEMPLATE_EN=gb_task_video_en
WHATSAPP_VIDEO_TEMPLATE_TA=gb_task_v1_ta
WHATSAPP_TEXT_TEMPLATE_EN=
WHATSAPP_TEXT_TEMPLATE_TA=
WHATSAPP_LANGUAGE_EN=en_US
WHATSAPP_LANGUAGE_TA=ta
WHATSAPP_QUICK_REPLY_BUTTONS=false
# gb_task_video_en uses a "Click Here" WhatsApp Flow button.
WHATSAPP_RESPONSE_MODE=flow
# Managed H.264/AAC transcoder webhook; requests are idempotent by assignment ID
MEDIA_PROCESSOR_URL=
MEDIA_PROCESSOR_SECRET=
# Create/connect a Vercel Blob store, then copy its Read/Write token here.
# Required to upload voice recordings and staff photos.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
